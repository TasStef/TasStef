---
import { brandMark } from '../../lib/brandMark';
import { flowStyle } from '../../lib/diagram';

/**
 * The "send back" action.
 *
 * Shape of the real thing: an action in the orchestrator makes a round trip to
 * a service, then the result fans out over Kafka to four consumers that
 * each do their own job with it.
 *
 * Drawn as the work actually was, rather than as ownership of the
 * messaging platform.
 */
const kafka = brandMark('apachekafka');

/* Boxes are declared once. Every line that meets one derives its endpoint
 * from these, so resizing a box moves the lines with it. */
const ORCH = { x: 8, y: 26, w: 110, h: 34 };
const SVC = { x: 186, y: 26, w: 104, h: 34 };

const orchRight = ORCH.x + ORCH.w;
const orchMidX = ORCH.x + ORCH.w / 2;
const orchBottom = ORCH.y + ORCH.h;
const svcLeft = SVC.x;
const svcMidX = SVC.x + SVC.w / 2;

/** Centre of the gap between the two boxes, for the round-trip labels. */
const gapMidX = (orchRight + svcLeft) / 2;
const roundTripLen = svcLeft - orchRight;

/* Topic is declared once so the bars, the badge that sits over them and the
 * feed out to the spine all stay in agreement. */
const TOPIC = { x: 14, w: 96, top: 126, barH: 13, gap: 4 };
const bars = [0, 1, 2].map((i) => TOPIC.top + i * (TOPIC.barH + TOPIC.gap));
const topicBottom = bars[bars.length - 1] + TOPIC.barH;
const topicMidX = TOPIC.x + TOPIC.w / 2;
const topicMidY = (TOPIC.top + topicBottom) / 2;

const PUBLISH_TO = 122;

const SPINE_X = 206;
const CONSUMER_X = 276;
const CONSUMER_W = 176;

/* Spaced to clear the service box above them: its bottom edge is at 60, so
 * the first consumer's top edge must sit below that with room to spare. At
 * the previous spacing the two overlapped by two units. */
const consumers = [
	{ y: 86, label: 'elastic reindex' },
	{ y: 128, label: 'audit' },
	{ y: 170, label: 'aggregation service' },
	{ y: 212, label: 'email service' },
];

const spineTop = consumers[0].y;
const spineBottom = consumers[consumers.length - 1].y;
---

<svg
	class="diagram"
	viewBox="0 0 460 260"
	role="img"
	aria-label="An orchestrator calling a service, then publishing one event that reindexing, audit, aggregation and email each react to"
	fill="none"
	stroke-linecap="round"
	stroke-linejoin="round"
>
	<text class="lane-label" x="0" y="14">WORKFLOW</text>

	{/* Round trip: the orchestrator asks, the service answers. */}
	<rect
		class="box box-accent"
		x={ORCH.x}
		y={ORCH.y}
		width={ORCH.w}
		height={ORCH.h}
		rx="9"
	/>
	<text class="step" x={orchMidX} y="47">orchestrator</text>

	<rect class="box" x={SVC.x} y={SVC.y} width={SVC.w} height={SVC.h} rx="9" />
	<text class="step" x={svcMidX} y="47">service</text>

	<path class="track" d={`M${orchRight} 36 H${svcLeft}`} />
	<path
		class="flow flow-fast"
		style={flowStyle(roundTripLen)}
		d={`M${orchRight} 36 H${svcLeft}`}
	/>
	<text class="step" x={gapMidX} y="22">request</text>

	<path class="track" d={`M${svcLeft} 50 H${orchRight}`} />
	<path
		class="flow flow-fast"
		style={flowStyle(roundTripLen)}
		d={`M${svcLeft} 50 H${orchRight}`}
	/>
	<text class="step" x={gapMidX} y="72">reply</text>

	{/* Then the result is published, and the orchestrator stops being involved. */}
	<path class="track" d={`M${orchMidX} ${orchBottom} V${PUBLISH_TO}`} />
	<path
		class="flow flow-fast"
		style={flowStyle(PUBLISH_TO - orchBottom)}
		d={`M${orchMidX} ${orchBottom} V${PUBLISH_TO}`}
	/>

	{/* Topic: stacked bars, the conventional shape for a log. */}
	{bars.map((y) => (
		<rect class="bar" x={TOPIC.x} y={y} width={TOPIC.w} height={TOPIC.barH} rx="4" />
	))}

	{/* Badge over the bars. The opaque disc is what makes it legible: laid
	    straight on top, the mark competes with three bar edges running
	    through it. */}
	{
		kafka && (
			<g>
				<circle class="badge" cx={topicMidX} cy={topicMidY} r="15" />
				<g transform={`translate(${topicMidX - 8.4} ${topicMidY - 8.4}) scale(0.7)`}>
					<path class="mark mark-bright" d={kafka.path} />
					<title>{kafka.title}</title>
				</g>
			</g>
		)
	}

	{/* Fan-out over a shared spine: four separate curves from one origin
	    reads as spaghetti at this size. */}
	<path class="track" d={`M${TOPIC.x + TOPIC.w} ${topicMidY} H${SPINE_X}`} />
	<path
		class="flow flow-fast"
		style={flowStyle(SPINE_X - (TOPIC.x + TOPIC.w))}
		d={`M${TOPIC.x + TOPIC.w} ${topicMidY} H${SPINE_X}`}
	/>
	<path class="track" d={`M${SPINE_X} ${spineTop} V${spineBottom}`} />

	{
		consumers.map((c) => (
			<>
				<path class="track" d={`M${SPINE_X} ${c.y} H${CONSUMER_X}`} />
				<path
					class="flow flow-fast"
					style={flowStyle(CONSUMER_X - SPINE_X)}
					d={`M${SPINE_X} ${c.y} H${CONSUMER_X}`}
				/>
				<rect
					class="box"
					x={CONSUMER_X}
					y={c.y - 16}
					width={CONSUMER_W}
					height="32"
					rx="9"
				/>
				<text class="step" x={CONSUMER_X + CONSUMER_W / 2} y={c.y + 5}>
					{c.label}
				</text>
			</>
		))
	}
</svg>

<style>
	.badge {
		fill: var(--bg);
		stroke: var(--border-strong);
		stroke-width: 1;
	}

	.mark-bright {
		fill: var(--text);
	}
</style>
