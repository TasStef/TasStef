---
import Section from './Section.astro';
import InterestIcon from './InterestIcon.astro';
import { profile } from '../data/profile';
---

<Section id="about" label="01 / About" heading="About me">
	<div class="about">
		<p class="about-lead reveal">{profile.intro}</p>

		<div class="about-meta">
			<div class="block reveal" style="--reveal-delay: 60ms">
			<h3 class="label block-title">Education</h3>
			<ul class="edu-list">
				{
					profile.education.map((e) => (
						<li class="edu">
							<span class="edu-qual">{e.qualification}</span>
							<span class="edu-inst">
								{e.institution} · {e.location}
							</span>
						</li>
					))
				}
			</ul>
		</div>

			<div class="block">
			<h3 class="label block-title reveal" style="--reveal-delay: 120ms">Outside work</h3>
			<ul class="interests">
				{
					profile.interests.map((i, idx) => (
						<li
							class="interest hairline raised reveal"
							style={`--reveal-delay: ${180 + idx * 110}ms`}
						>
							<div class="interest-head">
								<InterestIcon name={i.icon} />
								<span class="interest-name">{i.name}</span>
							</div>
							<span class="interest-note">{i.note}</span>
						</li>
					))
				}
			</ul>
			</div>
		</div>
	</div>
</Section>

<style>
	.about {
		display: flex;
		flex-direction: column;
		gap: var(--sp-12);
	}

	.about-lead {
		font-size: var(--step-1);
		color: var(--text-muted);
		max-width: var(--measure);
		text-wrap: pretty;
	}

	/* Education and Outside work share a row. Stacked by default; the
	   two-column form only switches on when there is room for three
	   interest cards across without crushing them. */
	.about-meta {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--sp-8);
		align-items: start;
	}

	@media (min-width: 60rem) {
		.about-meta {
			/* Uneven on purpose: Education is two short lines, Outside work
			   has to fit three cards side by side. */
			grid-template-columns: minmax(0, 0.78fr) minmax(0, 1.22fr);
		}
	}

	.block-title {
		color: var(--accent);
		margin-bottom: var(--sp-4);
	}

	/* Education: two degrees side by side once there is room. */
	.edu-list {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
		gap: var(--sp-6);
	}

	.edu {
		display: flex;
		flex-direction: column;
		gap: var(--sp-1);
	}

	.edu-qual {
		color: var(--text);
	}

	.edu-inst {
		font-size: var(--step--1);
		color: var(--text-muted);
	}

	/* Outside work: a card each, so the block carries some character
	   instead of reading as three nouns in pills. */
	.interests {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--sp-3);
	}


	.interest {
		display: flex;
		flex-direction: column;
		gap: var(--sp-2);
		padding: var(--sp-4) var(--sp-5, 1.25rem);
		transition:
			background-color var(--dur-base) var(--ease-out),
			box-shadow var(--dur-base) var(--ease-out),
			translate var(--dur-base) var(--ease-out);
	}

	.interest-head {
		display: flex;
		align-items: center;
		gap: var(--sp-3);
	}

	.interest:hover {
		background-color: var(--surface-hover);
		box-shadow: var(--shadow-2);
		translate: 0 -2px;
	}

	.interest-name {
		color: var(--text);
		font-size: var(--step-0);
		font-weight: 550;
	}

	.interest-note {
		font-size: var(--step--1);
		color: var(--text-muted);
		text-wrap: pretty;
	}
	/* Must come AFTER the base .interest rules: same specificity, so
	   source order decides. Declared earlier, the base rules won and the
	   overrides here silently did nothing. */
	@media (min-width: 60rem) {
		.interests {
			grid-template-columns: repeat(3, 1fr);
			gap: var(--sp-3);
		}

		/* Tightened at three across so the icon and label still share a
		   line in roughly 190px of card. */
		.interest {
			padding: var(--sp-4);
			gap: var(--sp-1);
		}

		.interest-head {
			gap: var(--sp-2);
		}

		.interest-head :global(.interest-icon) {
			width: 18px;
			height: 18px;
		}

		.interest-name {
			font-size: var(--step--1);
		}
	}
</style>
