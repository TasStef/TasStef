---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Stats from '../components/Stats.astro';
import About from '../components/About.astro';
import Experience from '../components/Experience.astro';
import Projects from '../components/Projects.astro';
import Skills from '../components/Skills.astro';
import Contact from '../components/Contact.astro';
---

<Base>
	{/*
	  Hero and Stats share one viewport-height grid so the numbers are always
	  above the fold. `1fr auto` means the stats are measured first and the
	  hero takes whatever is left, rather than the hero being given a guessed
	  height and hoping the stats fit underneath.
	*/}
	<div class="fold">
		<Hero />
		<Stats />
	</div>

	<About />
	<Projects />
	<Experience />
	<Skills />
	<Contact />
</Base>

<style>
	.fold {
		/* svh, not vh: on mobile, vh ignores browser chrome and the bottom of
		   the block sits underneath it, which is the exact problem this is
		   meant to solve. */
		min-height: 100svh;
		display: grid;
		grid-template-rows: 1fr auto;
	}

	/* Below this the guarantee stops being worth what it costs: holding it
	   means shrinking the display type until the hero stops working.
	   Landscape phones are the real case. Let it scroll instead. */
	@media (max-height: 600px) {
		.fold {
			min-height: 0;
		}
	}
</style>

<script>
	import { initMotion } from '../scripts/motion';
	initMotion();
</script>
