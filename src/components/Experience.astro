---
import { getCollection } from 'astro:content';
import Section from './Section.astro';

const roles = (await getCollection('experience')).sort(
	(a, b) => a.data.order - b.data.order
);

type Role = (typeof roles)[number];

interface Stint {
	company: string;
	context?: string;
	location: string;
	start: string;
	end: string | null;
	roles: Role[];
}

/**
 * Consecutive roles at the same company collapse into one stint.
 *
 * Grouping is derived here rather than stored, so each role stays one file
 * in src/data/experience/ and adding or reordering one needs no changes to
 * this component.
 */
const stints: Stint[] = [];
for (const role of roles) {
	const current = stints.at(-1);
	if (current && current.company === role.data.company) {
		current.roles.push(role);
		// Entries run newest first, so each later one pushes the start back.
		current.start = role.data.start;
	} else {
		stints.push({
			company: role.data.company,
			context: role.data.context,
			location: role.data.location,
			start: role.data.start,
			end: role.data.end,
			roles: [role],
		});
	}
}

---

<Section id="experience" label="03 / Experience" heading="Where I've worked">
	<ol class="timeline">
		{
			stints.map((stint, i) => {
				const multi = stint.roles.length > 1;

				return (
					<li class="stint reveal hairline raised" style={`--reveal-delay: ${i * 70}ms`}>
						<div class="stint-meta">
							<p class="label stint-dates">
								{stint.start} — {stint.end ?? 'Present'}
							</p>
							{!stint.end && <span class="badge">Current</span>}
						</div>

						<div class="stint-body">
							<div class="stint-head">
								<div class="stint-titles">
									<h3 class="stint-company">{stint.company}</h3>
									<p class="stint-context">
										{stint.context && <span>{stint.context} · </span>}
										{stint.location}
									</p>
								</div>
								{/*
								  Hidden until the script un-hides it. Without JS there is
								  no control and nothing is collapsed, so the content is
								  simply all visible rather than stuck behind a dead button.
								*/}
								<button class="stint-toggle" type="button" hidden aria-expanded="true">
									<span class="visually-hidden">Show details for {stint.company}</span>
									<svg
										class="chev"
										viewBox="0 0 16 16"
										width="14"
										height="14"
										aria-hidden="true"
										fill="none"
										stroke="currentColor"
										stroke-width="1.8"
										stroke-linecap="round"
										stroke-linejoin="round"
									>
										<path d="m4 6 4 4 4-4" />
									</svg>
								</button>
							</div>

							{/* Stands in for the hidden detail while collapsed. */}
							<p class="stint-preview">
								{stint.roles.map((r) => r.data.title).join(' · ')}
							</p>

							<div class="stint-content">
								<div class="stint-content-inner">
							<ol class:list={['roles', { progression: multi }]}>
								{stint.roles.map((role) => (
									<li class="role">
										<div class="role-head">
											<h4 class="role-title">{role.data.title}</h4>
											{multi && (
												<p class="label role-dates">
													{role.data.start} — {role.data.end ?? 'Present'}
												</p>
											)}
										</div>
										<ul class="highlights">
											{role.data.highlights.map((h) => (
												<li>{h}</li>
											))}
										</ul>
									</li>
								))}
							</ol>
								</div>
							</div>
						</div>
					</li>
				);
			})
		}
	</ol>
</Section>

<style>
	.timeline {
		display: flex;
		flex-direction: column;
		gap: var(--sp-4);
		margin: 0;
	}

	.stint {
		display: grid;
		grid-template-columns: minmax(10rem, 14rem) 1fr;
		gap: var(--sp-6);
		padding: var(--sp-6);
		transition:
			background-color var(--dur-base) var(--ease-out),
			box-shadow var(--dur-base) var(--ease-out),
			translate var(--dur-base) var(--ease-out);
	}

	/* This card is the click target once the collapse script runs, so it is
	   the one that earns the largest lift. */
	.stint:hover {
		background-color: var(--surface-hover);
		box-shadow: var(--shadow-2);
		translate: 0 -2px;
	}

	.stint-meta {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--sp-2);
	}

	.stint-dates {
		white-space: nowrap;
	}

	.badge {
		font-family: var(--font-mono);
		font-size: var(--step--1);
		letter-spacing: var(--tracking-label);
		text-transform: uppercase;
		color: var(--accent);
		border: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
		background: color-mix(in srgb, var(--accent) 10%, transparent);
		padding: 2px var(--sp-2);
		border-radius: 100px;
	}

	.stint-head {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: var(--sp-4);
	}

	/* The whole card is the hit area once the script is running. */
	:global(:root.has-collapse) .stint {
		cursor: pointer;
	}

	/* ...except the expanded detail, which is for reading, not toggling. */
	:global(:root.has-collapse) .stint-content {
		cursor: auto;
	}

	.stint-toggle {
		flex: none;
		display: grid;
		place-items: center;
		width: 28px;
		height: 28px;
		padding: 0;
		border: 1px solid var(--border);
		border-radius: 50%;
		background: transparent;
		color: var(--text-muted);
		cursor: pointer;
		transition:
			color var(--dur-fast) var(--ease-out),
			border-color var(--dur-fast) var(--ease-out);
	}

	.stint-toggle:hover {
		color: var(--accent);
		border-color: var(--accent);
	}

	.chev {
		transition: transform var(--dur-base) var(--ease-out);
	}

	/* Points down when there is more to see, up when expanded. */
	.stint:not(.is-collapsed) .chev {
		transform: rotate(180deg);
	}

	/* Replaces the detail while collapsed, so a closed card still says
	   which roles it holds rather than just a company name. */
	.stint-preview {
		display: none;
		margin-top: var(--sp-3);
		font-size: var(--step--1);
		color: var(--text-muted);
	}

	.stint.is-collapsed .stint-preview {
		display: block;
	}

	/* 0fr to 1fr animates to the content's natural height, which a
	   max-height transition cannot do without a magic number. */
	.stint-content {
		display: grid;
		grid-template-rows: 1fr;
	}

	:global(:root.has-collapse) .stint-content {
		transition: grid-template-rows var(--dur-base) var(--ease-out);
	}

	.stint.is-collapsed .stint-content {
		grid-template-rows: 0fr;
	}

	.stint-content-inner {
		overflow: hidden;
	}

	.stint-company {
		font-size: var(--step-1);
		letter-spacing: -0.015em;
	}

	.stint-context {
		color: var(--text-muted);
		font-size: var(--step--1);
		margin-top: var(--sp-1);
	}

	.roles {
		display: flex;
		flex-direction: column;
		gap: var(--sp-5, 1.25rem);
		margin-top: var(--sp-4);
	}

	/* Only grouped stints get the connector: it exists to show one role
	   leading to the next, which is meaningless with a single role. */
	.roles.progression .role {
		position: relative;
		padding-left: var(--sp-6);
	}

	.roles.progression .role::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0.42em;
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--accent);
	}

	.roles.progression .role::after {
		content: '';
		position: absolute;
		left: 3px;
		top: 1.3em;
		bottom: calc(-1 * var(--sp-6));
		width: 1px;
		background: var(--border-strong);
	}

	.roles.progression .role:last-child::after {
		display: none;
	}

	/* Title and dates share a line; stacked, they cost three extra lines
	   across the grouped stint and made the section taller than before. */
	.role-head {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: var(--sp-3);
	}

	.role-title {
		font-size: var(--step-0);
		font-weight: 550;
		letter-spacing: -0.01em;
	}

	.highlights {
		margin-top: var(--sp-3);
		display: flex;
		flex-direction: column;
		gap: var(--sp-2);
	}

	.highlights li {
		position: relative;
		padding-left: var(--sp-4);
		color: var(--text-muted);
		font-size: var(--step-0);
	}

	.highlights li::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0.66em;
		width: 5px;
		height: 1px;
		background: var(--accent);
	}

	@media (max-width: 40rem) {
		.stint {
			grid-template-columns: 1fr;
			gap: var(--sp-4);
		}

		.stint-meta {
			flex-direction: row;
			align-items: center;
			flex-wrap: wrap;
			gap: var(--sp-3);
		}
	}
</style>
