---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Experience from '../components/Experience.astro';
import Projects from '../components/Projects.astro';
import Skills from '../components/Skills.astro';
import Contact from '../components/Contact.astro';
---

<Base>
	<Hero />
	<Projects />
	<Experience />
	<Skills />
	<Contact />
</Base>

<script>
	// Scroll reveal. ~20 lines, the only JS on the page.
	//
	// Order matters: .has-reveal is added FIRST, and only from inside this
	// script. If the script never runs, the hiding rules never apply and
	// every section renders normally.
	const prefersReduced = window.matchMedia(
		'(prefers-reduced-motion: reduce)'
	).matches;

	const targets = document.querySelectorAll<HTMLElement>('.reveal');

	if (!prefersReduced && 'IntersectionObserver' in window && targets.length) {
		document.documentElement.classList.add('has-reveal');

		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (!entry.isIntersecting) continue;
					entry.target.classList.add('is-visible');
					observer.unobserve(entry.target);
				}
			},
			{ rootMargin: '0px 0px -8% 0px', threshold: 0.05 }
		);

		for (const el of targets) observer.observe(el);

		// Safety net: if anything goes wrong, reveal everything rather than
		// leaving content hidden.
		window.setTimeout(() => {
			for (const el of targets) el.classList.add('is-visible');
		}, 3000);
	}
</script>
