---
import Section from './Section.astro';
import { profile } from '../data/profile';
import ExternalIcon from './ExternalIcon.astro';

// No contact form: GitHub Pages serves static files and cannot process a
// POST. A form would mean a third-party dependency for very little gain.
// Phone number is deliberately omitted from the public page.
const [user, domain] = profile.email.split('@');
---

<Section id="contact" label="05 / Contact" heading="Get in touch">
	<div class="contact reveal">
		<p class="contact-lead">
			Open to interesting problems, particularly in fintech and developer tooling.
			The fastest way to reach me is email.
		</p>

		<ul class="channels">
			<li class="hairline raised channel">
				<span class="label">Email</span>
				<a class="channel-value" href={`mailto:${profile.email}`}>
					<span>{user}</span><span aria-hidden="true">@</span><span>{domain}</span>
				</a>
			</li>

			{
				profile.socials.map((s) => (
					<li class="hairline raised channel">
						<span class="label">{s.label}</span>
						<a class="channel-value" href={s.href} target="_blank" rel="me noopener noreferrer">
							{s.handle}
							<ExternalIcon />
							<span class="visually-hidden">(opens in a new tab)</span>
						</a>
					</li>
				))
			}
		</ul>
	</div>
</Section>

<style>
	.contact {
		display: flex;
		flex-direction: column;
		gap: var(--sp-8);
	}

	.contact-lead {
		color: var(--text-muted);
		max-width: var(--measure);
		font-size: var(--step-1);
	}

	.channels {
		display: grid;
		/* 17rem, not 15rem: at 15rem three columns survive down to widths
		   where the email no longer fits on one line and breaks mid-domain.
		   The wider minimum drops to two columns before that happens. */
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
		gap: var(--sp-4);
	}

	.channel {
		display: flex;
		flex-direction: column;
		gap: var(--sp-2);
		padding: var(--sp-6);
		transition:
			background-color var(--dur-base) var(--ease-out),
			box-shadow var(--dur-base) var(--ease-out),
			translate var(--dur-base) var(--ease-out);
	}

	.channel:hover {
		background-color: var(--surface-hover);
		box-shadow: var(--shadow-2);
		translate: 0 -2px;
	}

	.channel-value {
		/* Deliberately NOT a flex container. The email is split into three
		   spans to deter scrapers; as flex items those spans cannot wrap as
		   one text run, which broke the address mid-word. In normal inline
		   flow they are invisible to text layout. */
		font-size: var(--step-0);
		overflow-wrap: anywhere;
		transition: color var(--dur-fast) var(--ease-out);
	}

	.channel-value:hover {
		color: var(--accent);
	}

	.channel-value :global(.external-icon) {
		margin-left: var(--sp-2);
		vertical-align: baseline;
		display: inline-block;
	}
</style>
