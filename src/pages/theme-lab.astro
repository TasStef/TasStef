---
/**
 * Atmosphere lab — a system field seen from inside.
 *
 * Throwaway. Excluded from the sitemap in astro.config.mjs, marked noindex.
 * Delete once a direction is chosen; nothing else imports from here.
 *
 * Replaces an earlier three-way comparison of procedural noise, which was
 * three renderings of one idea and read as generic because of it. The thing
 * that makes a background feel expensive is not texture: it is lit objects
 * at different depths, with focus falling off, moving through space. So
 * this is a real 3D point field with perspective, depth of field and
 * additive light, rather than a 2D texture tinted with the brand colours.
 *
 * It also rhymes with the six system diagrams further down the page: nodes,
 * edges, and pulses travelling between them.
 *
 * Two panels, same field at two intensities, because the hero can carry
 * far more than a section of body copy can.
 */
import '../styles/global.css';
import { profile } from '../data/profile';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Atmosphere lab</title>
		<meta name="robots" content="noindex" />
	</head>
	<body>
		<section class="panel" id="hero-panel">
			<canvas class="field" data-field="hero"></canvas>
			<div class="scrim"></div>
			<div class="panel-inner">
				<p class="label">Hero intensity</p>
				<h1>{profile.name}</h1>
				<p class="pitch">{profile.pitch}</p>
				<p class="cost">
					<span class="chip">no asset, no dependency</span>
					<span class="chip fps" data-fps="hero">measuring...</span>
				</p>
			</div>
		</section>

		<section class="panel" id="body-panel">
			<canvas class="field" data-field="body"></canvas>
			<div class="scrim"></div>
			<div class="panel-inner">
				<p class="label">Body intensity — the same field, pulled right back</p>
				<h2>Things I've built</h2>
				<p class="body-copy">
					This is the level I would actually run behind the rest of the page.
					The question is not whether it looks good on its own, it is whether
					you can still read a paragraph sitting on top of it without
					noticing the background is there at all.
				</p>
				<p class="body-copy">
					Onboarding used to take three separate engineer touchpoints per
					client. Now clients connect their own books and go live in minutes.
					If any word in this paragraph is harder to read than it was on the
					flat background, the field is still too strong.
				</p>
				<p class="cost">
					<span class="chip fps" data-fps="body">measuring...</span>
				</p>
			</div>
		</section>

		<style>
			body {
				margin: 0;
			}

			.panel {
				position: relative;
				min-height: 100svh;
				display: grid;
				align-content: center;
				overflow: hidden;
				background: var(--bg);
			}

			.field {
				position: absolute;
				inset: 0;
				width: 100%;
				height: 100%;
				display: block;
				z-index: 0;
			}

			/* Keeps the text column darker than the rest of the frame. The
			   reference site does this with its grade; here it is a scrim. */
			.scrim {
				position: absolute;
				inset: 0;
				z-index: 1;
				pointer-events: none;
				background:
					linear-gradient(
						100deg,
						var(--bg) 0%,
						color-mix(in srgb, var(--bg) 70%, transparent) 38%,
						transparent 62%
					),
					radial-gradient(
						ellipse 120% 90% at 50% 50%,
						transparent 40%,
						var(--bg) 100%
					);
			}

			.panel-inner {
				position: relative;
				z-index: 2;
				width: min(68rem, 100%);
				margin-inline: auto;
				padding: var(--gutter);
				display: flex;
				flex-direction: column;
				align-items: flex-start;
				gap: var(--sp-4);
			}

			h1 {
				font-size: var(--step-4);
				font-weight: 600;
				margin: 0;
			}

			h2 {
				font-size: var(--step-3);
				font-weight: 560;
				margin: 0;
			}

			.pitch {
				font-size: var(--step-2);
				max-width: 22ch;
				line-height: 1.2;
				letter-spacing: -0.02em;
				margin: 0;
			}

			.body-copy {
				color: var(--text-muted);
				max-width: 46ch;
				margin: 0;
			}

			.cost {
				display: flex;
				gap: var(--sp-2);
				flex-wrap: wrap;
				margin: var(--sp-4) 0 0;
			}

			.chip {
				font-family: var(--font-mono);
				font-size: var(--step--1);
				border: 1px solid var(--border-strong);
				border-radius: 100px;
				padding: 2px var(--sp-3);
				background: var(--surface);
			}

			.fps {
				color: var(--accent);
			}
		</style>

		<script>
			type RGB = [number, number, number];

			/**
			 * Reads a colour token as 0-255 rgb.
			 *
			 * Handles BOTH forms this codebase uses: --bg and friends are hex,
			 * --glow and --surface are rgba(). Matching bare numbers is not
			 * enough — on '#06070c' that yields the single run '06070', because
			 * the match stops at the 'c', and the result is one component
			 * rather than three.
			 *
			 * Throws rather than returning a default. A silent fallback here
			 * painted the whole field white and read as an exposure problem
			 * instead of a parse failure.
			 */
			function token(name: string): RGB {
				const v = getComputedStyle(document.documentElement)
					.getPropertyValue(name)
					.trim();

				const hex = v.match(/^#([0-9a-f]{3}|[0-9a-f]{6})$/i);
				if (hex) {
					const h = hex[1];
					const full =
						h.length === 3
							? h[0] + h[0] + h[1] + h[1] + h[2] + h[2]
							: h;
					return [
						parseInt(full.slice(0, 2), 16),
						parseInt(full.slice(2, 4), 16),
						parseInt(full.slice(4, 6), 16),
					];
				}

				const nums = v.match(/[0-9.]+/g);
				if (nums && nums.length >= 3) {
					return [+nums[0], +nums[1], +nums[2]];
				}

				throw new Error(`Cannot parse colour token ${name}: "${v}"`);
			}

			/**
			 * Pre-rendered bokeh sprites, sharp through to fully defocused.
			 *
			 * Drawing a radial gradient per node per frame is the obvious way
			 * and far too slow. These are rendered once and blitted, which is
			 * what makes a few hundred lights affordable.
			 */
			function makeSprites(rgb: RGB, steps: number) {
				const out: HTMLCanvasElement[] = [];
				for (let i = 0; i < steps; i++) {
					const blur = i / (steps - 1); // 0 sharp .. 1 fully defocused
					const size = 64;
					const c = document.createElement('canvas');
					c.width = c.height = size;
					const g = c.getContext('2d');
					if (!g) continue;
					const r = size / 2;
					const grad = g.createRadialGradient(r, r, 0, r, r, r);
					// A sharp light is a tight core with a faint halo. A defocused
					// one spreads into a flat disc with a soft edge, which is what
					// real bokeh does and what sells the depth.
					// These alphas are deliberately low. Every sprite is composited
					// additively, so whatever each one contributes gets summed with
					// its neighbours; at full strength a few hundred of them just
					// sum to white, which is exactly what the first attempt did.
					const core = 0.04 + blur * 0.42;
					const [rr, gg, bb] = rgb;
					grad.addColorStop(0, `rgba(${rr}, ${gg}, ${bb}, ${0.95 - blur * 0.5})`);
					grad.addColorStop(core, `rgba(${rr}, ${gg}, ${bb}, ${0.5 - blur * 0.3})`);
					grad.addColorStop(
						Math.min(0.98, core + 0.22 + blur * 0.2),
						`rgba(${rr}, ${gg}, ${bb}, ${0.09 - blur * 0.045})`
					);
					grad.addColorStop(1, `rgba(${rr}, ${gg}, ${bb}, 0)`);
					g.fillStyle = grad;
					g.fillRect(0, 0, size, size);
					out.push(c);
				}
				return out;
			}

			interface Node {
				x: number;
				y: number;
				z: number;
				/** Palette index. */
				c: number;
				/** Base brightness, so the field is not uniformly lit. */
				b: number;
				/** Phase offsets for the slow idle drift. */
				px: number;
				py: number;
			}

			interface Edge {
				a: number;
				b: number;
				w: number;
			}

			interface Pulse {
				e: number;
				t: number;
				v: number;
			}

			interface FieldOptions {
				nodeCount: number;
				/** Overall output gain. The body panel runs far lower. */
				gain: number;
				edgeGain: number;
				pulseRate: number;
			}

			function buildField(
				canvas: HTMLCanvasElement,
				opts: FieldOptions,
				onFrame: () => void
			) {
				const ctx = canvas.getContext('2d');
				if (!ctx) return null;

				const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

				const glow = token('--glow');
				const glow2 = token('--glow-2');
				const palette: RGB[] = [
					glow,
					glow2,
					[226, 232, 240], // a few near-white lights, so it is not monochrome-blue
				];
				const SPRITE_STEPS = 7;
				const sprites = palette.map((p) => makeSprites(p, SPRITE_STEPS));

				// Field geometry. The camera sits at the origin looking down +z.
				const SPAN = 1000;
				// Z_NEAR has to be genuinely far from the camera. Projected scale
				// is F/z, so a node allowed to drift close to the lens blows up
				// into a screen-filling smear: at z=210 this rendered 500px wide.
				const Z_NEAR = 700;
				const Z_FAR = 2700;
				const FOCUS = 1400; // the depth that renders sharp
				const F = 900; // focal length for the projection

				const nodes: Node[] = [];
				for (let i = 0; i < opts.nodeCount; i++) {
					nodes.push({
						x: (Math.random() - 0.5) * SPAN * 2.4,
						y: (Math.random() - 0.5) * SPAN * 1.6,
						z: Z_NEAR + Math.random() * (Z_FAR - Z_NEAR),
						// Mostly the two glow hues; white is rare on purpose.
						c: Math.random() < 0.12 ? 2 : Math.random() < 0.5 ? 0 : 1,
						b: 0.45 + Math.random() * 0.55,
						px: Math.random() * Math.PI * 2,
						py: Math.random() * Math.PI * 2,
					});
				}

				/**
				 * Topology is computed ONCE, from the base positions. The camera
				 * moves and the nodes only breathe, so recomputing neighbours every
				 * frame would burn O(n^2) for a result that barely changes.
				 */
				const edges: Edge[] = [];
				const LINK_DIST = 560;
				for (let i = 0; i < nodes.length; i++) {
					let made = 0;
					for (let j = i + 1; j < nodes.length && made < 3; j++) {
						const dx = nodes[i].x - nodes[j].x;
						const dy = nodes[i].y - nodes[j].y;
						const dz = nodes[i].z - nodes[j].z;
						const d = Math.sqrt(dx * dx + dy * dy + dz * dz);
						if (d < LINK_DIST) {
							edges.push({ a: i, b: j, w: 1 - d / LINK_DIST });
							made++;
						}
					}
				}

				const pulses: Pulse[] = [];

				let w = 0;
				let h = 0;
				let dpr = 1;
				const resize = () => {
					dpr = Math.min(devicePixelRatio || 1, 1.5);
					w = canvas.clientWidth;
					h = canvas.clientHeight;
					canvas.width = Math.max(1, Math.round(w * dpr));
					canvas.height = Math.max(1, Math.round(h * dpr));
				};
				resize();
				addEventListener('resize', resize);

				const bg = token('--bg');

				// An arrow const rather than a hoisted `function`: a hoisted
				// declaration could in principle run before the null guard above,
				// so TypeScript will not keep the narrowing on ctx across it.
				const draw = (time: number) => {
					const t = time / 1000;
					ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
					ctx.globalCompositeOperation = 'source-over';
					ctx.fillStyle = `rgb(${bg[0]}, ${bg[1]}, ${bg[2]})`;
					ctx.fillRect(0, 0, w, h);

					// Slow yaw plus lateral drift. Rotation is what produces real
					// parallax between near and far nodes; drifting alone reads as
					// a flat image sliding around.
					const yaw = Math.sin(t * 0.045) * 0.26;
					const cosY = Math.cos(yaw);
					const sinY = Math.sin(yaw);
					const camX = Math.sin(t * 0.031) * 120;
					const camY = Math.cos(t * 0.024) * 70;

					const cx = w / 2;
					const cy = h / 2;

					// Project every node once; edges and pulses reuse the results.
					const sx = new Float32Array(nodes.length);
					const sy = new Float32Array(nodes.length);
					const sz = new Float32Array(nodes.length);
					const sa = new Float32Array(nodes.length);

					for (let i = 0; i < nodes.length; i++) {
						const n = nodes[i];
						// Idle breathing, small enough that fixed topology still reads.
						const bx = n.x + Math.sin(t * 0.18 + n.px) * 14;
						const by = n.y + Math.cos(t * 0.15 + n.py) * 14;

						const rx = bx * cosY - n.z * sinY - camX;
						const rz = bx * sinY + n.z * cosY;
						const ry = by - camY;

						sz[i] = rz;
						// Cull at the near plane itself, not a fraction of it.
						if (rz <= Z_NEAR) {
							sa[i] = 0;
							continue;
						}
						const k = F / rz;
						sx[i] = cx + rx * k;
						sy[i] = cy + ry * k;
						// Fade out at the far plane so nodes do not pop.
						sa[i] = Math.max(0, Math.min(1, (Z_FAR - rz) / 900)) * n.b;
					}

					// Edges first, underneath the lights.
					ctx.globalCompositeOperation = 'lighter';
					ctx.lineWidth = 1;
					for (let e = 0; e < edges.length; e++) {
						const { a, b, w: ew } = edges[e];
						const aa = sa[a];
						const ab = sa[b];
						if (aa <= 0 || ab <= 0) continue;
						const depth = (sz[a] + sz[b]) / 2;
						const fade = Math.max(0, 1 - Math.abs(depth - FOCUS) / 1500);
						const alpha = ew * fade * Math.min(aa, ab) * 0.17 * opts.edgeGain;
						if (alpha < 0.004) continue;
						ctx.strokeStyle = `rgba(${glow[0]}, ${glow[1]}, ${glow[2]}, ${alpha})`;
						ctx.beginPath();
						ctx.moveTo(sx[a], sy[a]);
						ctx.lineTo(sx[b], sy[b]);
						ctx.stroke();
					}

					// Lights, far to near, so nearer bokeh sits on top.
					const order = Array.from(nodes.keys()).sort((p, q) => sz[q] - sz[p]);
					for (const i of order) {
						const alpha = sa[i];
						if (alpha <= 0.004) continue;
						const rz = sz[i];
						// Defocus grows either side of the focal plane, and an
						// out-of-focus light gets BIGGER and dimmer, not just smaller.
						const defocus = Math.min(1, Math.abs(rz - FOCUS) / 1150);
						const step = Math.min(
							SPRITE_STEPS - 1,
							Math.round(defocus * (SPRITE_STEPS - 1))
						);
						const scale = F / rz;
						const size = Math.min(140, (7 + defocus * 52) * scale);
						if (size < 0.6) continue;
						// 0.13 is the exposure. Additive compositing means the visible
						// brightness is the sum over every overlapping sprite, so the
						// per-node figure has to stay well under what looks right for
						// a single light in isolation.
						ctx.globalAlpha = alpha * (1 - defocus * 0.45) * 0.85 * opts.gain;
						ctx.drawImage(
							sprites[nodes[i].c][step],
							sx[i] - size / 2,
							sy[i] - size / 2,
							size,
							size
						);
					}
					ctx.globalAlpha = 1;

					// Pulses: rare, short, and travelling along a real edge. This is
					// the one part that is not ambient — it is the page's own flow
					// animation, moved into the background.
					if (!reduced && edges.length && Math.random() < opts.pulseRate) {
						pulses.push({
							e: (Math.random() * edges.length) | 0,
							t: 0,
							v: 0.14 + Math.random() * 0.18,
						});
					}
					for (let i = pulses.length - 1; i >= 0; i--) {
						const p = pulses[i];
						p.t += p.v * 0.016;
						if (p.t >= 1) {
							pulses.splice(i, 1);
							continue;
						}
						const { a, b } = edges[p.e];
						if (sa[a] <= 0 || sa[b] <= 0) continue;
						const px = sx[a] + (sx[b] - sx[a]) * p.t;
						const py = sy[a] + (sy[b] - sy[a]) * p.t;
						const depth = sz[a] + (sz[b] - sz[a]) * p.t;
						const defocus = Math.min(1, Math.abs(depth - FOCUS) / 1150);
						const step = Math.min(
							SPRITE_STEPS - 1,
							Math.round(defocus * (SPRITE_STEPS - 1))
						);
						// Brightest in the middle of the run, so it reads as a
						// travelling glint rather than a dot that blinks on and off.
						const life = Math.sin(p.t * Math.PI);
						const size = Math.min(70, (6 + defocus * 16) * (F / depth));
						ctx.globalAlpha = life * 0.95 * opts.gain;
						ctx.drawImage(
							sprites[2][step],
							px - size / 2,
							py - size / 2,
							size,
							size
						);
					}
					ctx.globalAlpha = 1;
					ctx.globalCompositeOperation = 'source-over';

					onFrame();
				};

				let running = false;
				const loop = (time: number) => {
					if (!running) return;
					draw(time);
					requestAnimationFrame(loop);
				};

				if (reduced) {
					// One static frame: the field is composition, not motion, so it
					// still reads with everything held still.
					draw(0);
					return { start() {}, stop() {} };
				}

				return {
					start() {
						if (!running) {
							running = true;
							requestAnimationFrame(loop);
						}
					},
					stop() {
						running = false;
					},
				};
			}

			function meter(id: string) {
				const el = document.querySelector<HTMLElement>('[data-fps="' + id + '"]');
				let frames = 0;
				let last = performance.now();
				return () => {
					frames++;
					const now = performance.now();
					if (now - last >= 1000) {
						if (el) {
							el.textContent = Math.round((frames * 1000) / (now - last)) + ' fps';
						}
						frames = 0;
						last = now;
					}
				};
			}

			const configs: Record<string, FieldOptions> = {
				hero: { nodeCount: 190, gain: 1, edgeGain: 1, pulseRate: 0.022 },
				// Same field, roughly a third of the light and no pulses to catch
				// the eye while someone is trying to read.
				body: { nodeCount: 150, gain: 0.34, edgeGain: 0.5, pulseRate: 0.004 },
			};

			for (const key of Object.keys(configs)) {
				const canvas = document.querySelector<HTMLCanvasElement>(
					'[data-field="' + key + '"]'
				);
				if (!canvas) continue;
				const field = buildField(canvas, configs[key], meter(key));
				if (!field) continue;
				const panel = canvas.closest('section');
				if (!panel) {
					field.start();
					continue;
				}
				new IntersectionObserver(
					(entries) =>
						entries.forEach((e) => (e.isIntersecting ? field.start() : field.stop())),
					{ threshold: 0.05 }
				).observe(panel);
			}
		</script>
	</body>
</html>
