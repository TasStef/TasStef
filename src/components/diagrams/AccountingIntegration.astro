---
import { brandMark } from '../../lib/brandMark';

/**
 * Self-serve accounting integration.
 *
 * The real story is not just "fewer steps": three of the six old steps
 * needed an engineer, and none of the new ones do. Engineer steps are
 * therefore marked, and the absence of any marked node in the AFTER lane
 * is the point the drawing is making.
 *
 * The 90% and 10x live in the row's metric line rather than in here, so
 * the diagram never implies a scale it is not actually drawing.
 */
const xero = brandMark('xero');
const quickbooks = brandMark('quickbooks');

interface Step {
	x: number;
	label: string;
	/** Needed an engineer. */
	eng?: boolean;
}

const before: Step[] = [
	{ x: 40, label: 'meeting' },
	{ x: 118, label: 'request' },
	{ x: 196, label: 'auth setup', eng: true },
	{ x: 274, label: 'client auth' },
	{ x: 352, label: 'data flow', eng: true },
	{ x: 430, label: 'monitor', eng: true },
];

// Labels alternate height so neighbours cannot collide: at this spacing a
// single row would overlap on the longer words.
const labelY = (i: number) => (i % 2 === 0 ? 112 : 132);
---

<svg
	class="diagram"
	viewBox="0 0 460 250"
	role="img"
	aria-label="Client onboarding before and after: six steps with three engineer touchpoints, reduced to four steps with none"
	fill="none"
	stroke-linecap="round"
	stroke-linejoin="round"
>
	<!-- ================= BEFORE ================= -->
	<text class="lane-label" x="0" y="44">BEFORE</text>
	<circle class="node-dot eng legend-dot" cx="86" cy="39" r="5" />
	<text class="legend" x="98" y="44">engineer step</text>

	<path class="track" d="M40 86 H430" />
	<path class="flow flow-slow" style="--len: 390px; --gap: 376px" d="M40 86 H430" />

	{
		before.map((s, i) => (
			<>
				<circle
					class:list={['node-dot', { eng: s.eng }]}
					cx={s.x}
					cy="86"
					r={s.eng ? 6 : 4.5}
				/>
				<text class:list={['step', { eng: s.eng }]} x={s.x} y={labelY(i)}>
					{s.label}
				</text>
			</>
		))
	}

	<!-- ================= AFTER ================= -->
	<text class="lane-label accent" x="0" y="178">AFTER</text>

	<path class="track" d="M40 210 H286" />
	<path class="flow flow-fast" style="--len: 246px; --gap: 232px" d="M40 210 H286" />

	<circle class="node-dot" cx="40" cy="210" r="4.5" />
	<text class="step" x="40" y="238">platform</text>

	{/* The two providers a client can connect, shown rather than named. */}
	<rect class="box" x="92" y="194" width="72" height="32" rx="9" />
	<g transform="translate(104 202) scale(0.67)">
		{xero ? <path class="mark" d={xero.path} /> : <text class="fallback" x="12" y="18">X</text>}
		{xero && <title>{xero.title}</title>}
	</g>
	<g transform="translate(132 202) scale(0.67)">
		{
			quickbooks ? (
				<path class="mark" d={quickbooks.path} />
			) : (
				<text class="fallback" x="12" y="18">QB</text>
			)
		}
		{quickbooks && <title>{quickbooks.title}</title>}
	</g>
	<text class="step" x="128" y="238">connect</text>

	<circle class="node-dot" cx="212" cy="210" r="4.5" />
	<text class="step" x="212" y="238">client</text>

	<circle class="live-halo" cx="286" cy="210" r="11" />
	<circle class="node-dot live" cx="286" cy="210" r="6" />
	<text class="step accent" x="286" y="238">done</text>
</svg>

<style>
	.diagram {
		/* --- Flow tuning --------------------------------------------
		 * AFTER must be faster in absolute terms as well as shorter, or
		 * the animation argues against the point the diagram is making.
		 */
		--flow-base: 1.6s; /* AFTER: 246 units, ~154 u/s */
		--flow-slow: 8s; /* BEFORE: 390 units, ~49 u/s */
		--flow-dash: 14px;

		width: 100%;
		height: auto;
		display: block;
		overflow: visible;
	}

	.track {
		stroke: var(--border-strong);
		stroke-width: 1;
	}

	.node-dot {
		fill: var(--bg);
		stroke: var(--border-strong);
		stroke-width: 1;
	}

	/* Steps that consumed engineering time. Three in the old flow, none in
	   the new one, which is the comparison worth making. */
	.node-dot.eng {
		fill: var(--accent);
		stroke: var(--accent);
	}

	/* A ring, not a fill: solid accent is reserved for engineer steps, so
	   the final node cannot be misread as one more of them. */
	.live {
		fill: var(--bg);
		stroke: var(--accent);
		stroke-width: 2.5;
	}

	.live-halo {
		fill: none;
		stroke: var(--accent);
		stroke-width: 1;
		opacity: 0.28;
	}

	.box {
		fill: var(--bg-raised);
		stroke: var(--border-strong);
		stroke-width: 1;
	}

	.mark {
		fill: var(--text-muted);
	}

	/* Sized in viewBox units, so these shrink with the drawing. At 375px it
	 * renders near 0.68 scale, so anything under ~15 here is unreadable. */
	.lane-label {
		font-family: var(--font-mono);
		fill: var(--text-faint);
		font-size: 16px;
		letter-spacing: 0.1em;
	}

	.lane-label.accent {
		fill: var(--accent);
	}

	.step {
		font-family: var(--font-mono);
		fill: var(--text-faint);
		font-size: 14px;
		text-anchor: middle;
	}

	.step.eng,
	.step.accent {
		fill: var(--accent);
	}

	.legend {
		font-family: var(--font-mono);
		fill: var(--text-faint);
		font-size: 13px;
		letter-spacing: 0.06em;
	}

	.fallback {
		font-family: var(--font-mono);
		fill: var(--text-muted);
		font-size: 11px;
		text-anchor: middle;
	}

	/* --len is each path's real length, WITH units: unitless, the keyframe's
	 * calc is invalid and the animation runs while moving nothing. --gap is
	 * precomputed because calc() inside a dasharray list is left unresolved
	 * and drops the whole pattern. */
	.flow {
		stroke: var(--accent);
		stroke-width: 2;
		stroke-dasharray: var(--flow-dash) var(--gap);
		animation: flow var(--flow-base) linear infinite;
	}

	.flow-slow {
		animation-duration: var(--flow-slow);
	}

	.flow-fast {
		animation-duration: var(--flow-base);
	}

	@keyframes flow {
		to {
			stroke-dashoffset: calc(-1 * var(--len));
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.flow {
			animation: none;
			opacity: 0;
		}
	}
</style>
