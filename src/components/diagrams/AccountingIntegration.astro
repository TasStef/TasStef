---
import { brandMark } from '../../lib/brandMark';

/**
 * Self-serve accounting integration.
 *
 * The real story is not just "fewer steps": three of the six old steps
 * needed an engineer, and none of the new ones do. Engineer steps are
 * therefore marked, and the absence of any marked node in the AFTER lane
 * is the point the drawing is making.
 *
 * The 90% and 10x live in the row's metric line rather than in here, so
 * the diagram never implies a scale it is not actually drawing.
 */
const xero = brandMark('xero');
const quickbooks = brandMark('quickbooks');

interface Step {
	label: string;
	/** Needed an engineer. */
	eng?: boolean;
}

/** Both lanes start here; each ends where its own track ends. */
const LANE_START = 40;
const BEFORE_END = 430;
const AFTER_END = 286;

/**
 * Spaces nodes evenly between two x positions.
 *
 * Positions are derived rather than written down so adding or removing a
 * step re-balances the lane on its own. Hardcoded coordinates meant a
 * removed node left a gap and the rest stayed put.
 */
function spread<T>(items: T[], start: number, end: number): (T & { x: number })[] {
	if (items.length === 1) {
		return [{ ...items[0], x: (start + end) / 2 }];
	}
	const step = (end - start) / (items.length - 1);
	return items.map((item, i) => ({ ...item, x: start + i * step }));
}

const before = spread<Step>(
	[
		{ label: 'request' },
		{ label: 'auth setup', eng: true },
		{ label: 'client auth' },
		{ label: 'data flow', eng: true },
		{ label: 'monitor', eng: true },
	],
	LANE_START,
	BEFORE_END
);

const after = spread<{ label: string; kind: 'dot' | 'box' | 'end' }>(
	[
		{ label: 'platform', kind: 'dot' },
		{ label: 'connect', kind: 'box' },
		{ label: 'done', kind: 'end' },
	],
	LANE_START,
	AFTER_END
);

// Labels alternate height so neighbours cannot collide: at this spacing a
// single row would overlap on the longer words.
const labelY = (i: number) => (i % 2 === 0 ? 112 : 132);

const DASH = 14;
const BOX_W = 72;
const MARK_SCALE = 0.67;
const MARK_W = 24 * MARK_SCALE;
---

<svg
	class="diagram"
	viewBox="0 0 460 250"
	role="img"
	aria-label="Client onboarding before and after: six steps with three engineer touchpoints, reduced to four steps with none"
	fill="none"
	stroke-linecap="round"
	stroke-linejoin="round"
>
	<!-- ================= BEFORE ================= -->
	<text class="lane-label" x="0" y="44">BEFORE</text>
	<circle class="node-dot eng legend-dot" cx="86" cy="39" r="5" />
	<text class="legend" x="98" y="44">engineer step</text>

	<path class="track" d={`M${LANE_START} 86 H${BEFORE_END}`} />
	<path
		class="flow flow-slow"
		style={`--len: ${BEFORE_END - LANE_START}px; --gap: ${BEFORE_END - LANE_START - DASH}px; --flow-dash: ${DASH}px`}
		d={`M${LANE_START} 86 H${BEFORE_END}`}
	/>

	{
		before.map((s, i) => (
			<>
				<circle
					class:list={['node-dot', { eng: s.eng }]}
					cx={s.x}
					cy="86"
					r={s.eng ? 6 : 4.5}
				/>
				<text class:list={['step', { eng: s.eng }]} x={s.x} y={labelY(i)}>
					{s.label}
				</text>
			</>
		))
	}

	<!-- ================= AFTER ================= -->
	<text class="lane-label accent" x="0" y="178">AFTER</text>

	<path class="track" d={`M${LANE_START} 210 H${AFTER_END}`} />
	<path
		class="flow flow-fast"
		style={`--len: ${AFTER_END - LANE_START}px; --gap: ${AFTER_END - LANE_START - DASH}px; --flow-dash: ${DASH}px`}
		d={`M${LANE_START} 210 H${AFTER_END}`}
	/>

	{
		after.map((n) => (
			<>
				{n.kind === 'dot' && <circle class="node-dot" cx={n.x} cy="210" r="4.5" />}

				{/* The two providers a client can connect, shown rather than named. */}
				{n.kind === 'box' && (
					<>
						<rect
							class="box"
							x={n.x - BOX_W / 2}
							y="194"
							width={BOX_W}
							height="32"
							rx="9"
						/>
						<g transform={`translate(${n.x - MARK_W - 2} 202) scale(${MARK_SCALE})`}>
							{xero ? (
								<path class="mark" data-brand="xero" d={xero.path} />
							) : (
								<text class="fallback" x="12" y="18">X</text>
							)}
							{xero && <title>{xero.title}</title>}
						</g>
						<g transform={`translate(${n.x + 2} 202) scale(${MARK_SCALE})`}>
							{quickbooks ? (
								<path class="mark" data-brand="quickbooks" d={quickbooks.path} />
							) : (
								<text class="fallback" x="12" y="18">QB</text>
							)}
							{quickbooks && <title>{quickbooks.title}</title>}
						</g>
					</>
				)}

				{n.kind === 'end' && (
					<>
						<circle class="live-halo" cx={n.x} cy="210" r="11" />
						<circle class="node-dot live" cx={n.x} cy="210" r="6" />
					</>
				)}

				<text class:list={['step', { accent: n.kind === 'end' }]} x={n.x} y="238">
					{n.label}
				</text>
			</>
		))
	}
</svg>
