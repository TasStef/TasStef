---
import type { CollectionEntry } from 'astro:content';
import ProjectDiagram from './ProjectDiagram.astro';

interface Props {
	project: CollectionEntry<'projects'>;
	index: number;
}

const { project, index } = Astro.props;
const { title, where, blurb, tech, diagram, metrics } = project.data;

// Alternate which side the diagram sits on. Collapses to one column below
// 60rem, where two columns of a flowchart is unreadable.
const flipped = index % 2 === 1;
---

<article class:list={['row', 'reveal', { flipped }]} style={`--reveal-delay: ${index * 70}ms`}>
	<div class="row-figure hairline raised tilt">
		<ProjectDiagram name={diagram} />
	</div>

	<div class="row-copy">
		<p class="label row-where">{where}</p>
		<h3 class="row-title">{title}</h3>
		<p class="row-blurb">{blurb}</p>

		<ul class="tech">
			{tech.map((t) => <li>{t}</li>)}
		</ul>

		{
			metrics && metrics.length > 0 && (
				<ul class="metrics">
					{metrics.map((m) => (
						<li class="metric">
							<span class="metric-value">{m.value}</span>
							<span class="metric-label">{m.label}</span>
						</li>
					))}
				</ul>
			)
		}
	</div>
</article>

<style>
	.row {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--sp-6);
		align-items: center;
	}

	@media (min-width: 60rem) {
		.row {
			grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
			gap: var(--sp-12);
		}

		/* Swap the visual order only; the DOM order stays diagram-then-copy
		   so screen readers and keyboard order are consistent down the page. */
		.row.flipped .row-figure {
			order: 2;
		}
	}

	.row-figure {
		/* Tight on narrow screens: every pixel of padding is a pixel the
		   diagram loses, and it is already scaled down there. */
		padding: var(--sp-3);
		border-radius: var(--radius);
	}

	/* ---- Hover tilt ----
	   Gated on the root class motion.ts adds, so without JS the figure never
	   gets a transform at all: no stacking context, nothing to go wrong.
	   The script only adds the class on a device that actually hovers.

	   This figure is not clickable, and everywhere else on the page a hover
	   response means "you can click this". A tilt reads as depth rather than
	   as an affordance, which is why it is the one hover this surface gets. */
	:global(:root.has-tilt) .row-figure {
		transform: perspective(var(--tilt-perspective))
			rotateX(var(--tilt-x, 0deg)) rotateY(var(--tilt-y, 0deg));
		/* Deliberately NO transform transition while tracking. The angles are
		   rewritten every frame, so a transition restarts on every write and
		   never arrives: measured at under 1% of the target angle, which
		   rendered as a card that simply would not tilt. Following the
		   pointer is already smooth because the pointer is. */
		transition: box-shadow var(--dur-base) var(--ease-out);
	}

	:global(:root.has-tilt) .row-figure:hover {
		box-shadow: var(--shadow-2);
	}

	/* The one moment a transform transition is right: the pointer has left
	   and the angles change once, so nothing restarts it. The class is added
	   for the length of the return and then taken off again. */
	:global(:root.has-tilt) .row-figure.is-returning {
		transition:
			transform 420ms var(--ease-out),
			box-shadow var(--dur-base) var(--ease-out);
	}

	@media (min-width: 45rem) {
		.row-figure {
			padding: var(--sp-6);
		}
	}

	.row-copy {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--sp-3);
	}

	.row-where {
		color: var(--text-muted);
	}

	.row-title {
		font-size: var(--step-2);
		letter-spacing: -0.02em;
	}

	.row-blurb {
		color: var(--text-muted);
		max-width: 46ch;
	}

	.tech {
		display: flex;
		flex-wrap: wrap;
		gap: var(--sp-2);
		margin-top: var(--sp-1);
	}

	.tech li {
		font-family: var(--font-mono);
		font-size: var(--step--1);
		color: var(--text-muted);
		border: 1px solid var(--border);
		border-radius: var(--radius-sm);
		box-shadow: var(--edge);
		padding: 2px var(--sp-2);
	}

	.metrics {
		display: flex;
		flex-wrap: wrap;
		gap: var(--sp-6);
		margin-top: var(--sp-2);
		padding-top: var(--sp-3);
		border-top: 1px solid var(--border);
		width: 100%;
	}

	.metric {
		display: flex;
		align-items: baseline;
		gap: var(--sp-2);
	}

	.metric-value {
		font-size: var(--step-2);
		font-weight: 600;
		letter-spacing: var(--tracking-display);
		color: var(--text);
	}

	.metric-label {
		font-family: var(--font-mono);
		font-size: var(--step--1);
		color: var(--accent);
	}
</style>
