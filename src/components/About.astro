---
import Section from './Section.astro';
import InterestIcon from './InterestIcon.astro';
import { profile } from '../data/profile';
---

<Section id="about" label="01 / About" heading="About me">
	<div class="about">
		<p class="about-lead reveal">{profile.intro}</p>

		<div class="about-meta">
			<div class="block reveal" style="--reveal-delay: 60ms">
			<h3 class="label block-title">Education</h3>
			<ul class="edu-list">
				{
					profile.education.map((e) => (
						<li class="edu">
							<span class="edu-qual">{e.qualification}</span>
							<span class="edu-inst">
								{e.institution} · {e.location}
							</span>
						</li>
					))
				}
			</ul>
		</div>

			<div class="block reveal" style="--reveal-delay: 120ms">
			<h3 class="label block-title">Outside work</h3>
			<ul class="interests">
				{
					profile.interests.map((i) => (
						<li class="interest hairline">
							<InterestIcon name={i.icon} />
							<div class="interest-text">
								<span class="interest-name">{i.name}</span>
								<span class="interest-note">{i.note}</span>
							</div>
						</li>
					))
				}
			</ul>
			</div>
		</div>
	</div>
</Section>

<style>
	.about {
		display: flex;
		flex-direction: column;
		gap: var(--sp-12);
	}

	.about-lead {
		font-size: var(--step-1);
		color: var(--text-muted);
		max-width: var(--measure);
		text-wrap: pretty;
	}

	/* Education and Outside work share a row again; they only went full
	   width while the interest cards were laid out horizontally. */
	.about-meta {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
		gap: var(--sp-8);
		align-items: start;
	}

	.block-title {
		color: var(--accent);
		margin-bottom: var(--sp-4);
	}

	/* Education: two degrees side by side once there is room. */
	.edu-list {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
		gap: var(--sp-6);
	}

	.edu {
		display: flex;
		flex-direction: column;
		gap: var(--sp-1);
	}

	.edu-qual {
		color: var(--text);
	}

	.edu-inst {
		font-size: var(--step--1);
		color: var(--text-muted);
	}

	/* Outside work: a card each, so the block carries some character
	   instead of reading as three nouns in pills. */
	.interests {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--sp-3);
	}

	.interest {
		display: flex;
		align-items: flex-start;
		gap: var(--sp-4);
		padding: var(--sp-5, 1.25rem) var(--sp-6);
		background: var(--surface);
		transition:
			background var(--dur-base) var(--ease-out),
			transform var(--dur-base) var(--ease-out);
	}

	.interest:hover {
		background: var(--surface-hover);
		transform: translateY(-2px);
	}

	.interest-text {
		display: flex;
		flex-direction: column;
		gap: var(--sp-1);
	}

	.interest-name {
		color: var(--text);
		font-size: var(--step-0);
		font-weight: 550;
	}

	.interest-note {
		font-size: var(--step--1);
		color: var(--text-muted);
		text-wrap: pretty;
	}
</style>
