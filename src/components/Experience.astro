---
import { getCollection } from 'astro:content';
import Section from './Section.astro';

const roles = (await getCollection('experience')).sort(
	(a, b) => a.data.order - b.data.order
);
---

<Section id="experience" label="02 / Experience" heading="Where I've worked">
	<ol class="timeline">
		{
			roles.map((role, i) => (
				<li class="role reveal hairline" style={`--reveal-delay: ${i * 60}ms`}>
					<div class="role-meta">
						<p class="label role-dates">
							{role.data.start} — {role.data.end ?? 'Present'}
						</p>
						{!role.data.end && <span class="badge">Current</span>}
					</div>

					<div class="role-body">
						<h3 class="role-title">{role.data.title}</h3>
						<p class="role-company">
							{role.data.company}
							{role.data.context && <span class="role-context"> · {role.data.context}</span>}
							<span class="role-context"> · {role.data.location}</span>
						</p>
						<ul class="highlights">
							{role.data.highlights.map((h) => (
								<li>{h}</li>
							))}
						</ul>
					</div>
				</li>
			))
		}
	</ol>
</Section>

<style>
	.timeline {
		display: flex;
		flex-direction: column;
		gap: var(--sp-4);
		margin: 0;
	}

	.role {
		display: grid;
		grid-template-columns: minmax(10rem, 14rem) 1fr;
		gap: var(--sp-6);
		padding: var(--sp-6);
		background: var(--surface);
		transition: background var(--dur-base) var(--ease-out);
	}

	.role:hover {
		background: var(--surface-hover);
	}

	.role-meta {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--sp-2);
	}

	.role-dates {
		white-space: nowrap;
	}

	.badge {
		font-family: var(--font-mono);
		font-size: var(--step--1);
		letter-spacing: var(--tracking-label);
		text-transform: uppercase;
		color: var(--accent);
		border: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
		background: color-mix(in srgb, var(--accent) 10%, transparent);
		padding: 2px var(--sp-2);
		border-radius: 100px;
	}

	.role-title {
		font-size: var(--step-1);
		letter-spacing: -0.015em;
	}

	.role-company {
		color: var(--text-muted);
		font-size: var(--step--1);
		margin-top: var(--sp-1);
	}

	.role-context {
		color: var(--text-faint);
	}

	.highlights {
		margin-top: var(--sp-4);
		display: flex;
		flex-direction: column;
		gap: var(--sp-2);
	}

	.highlights li {
		position: relative;
		padding-left: var(--sp-4);
		color: var(--text-muted);
		font-size: var(--step-0);
	}

	.highlights li::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0.66em;
		width: 5px;
		height: 1px;
		background: var(--accent);
	}

	@media (max-width: 40rem) {
		.role {
			grid-template-columns: 1fr;
			gap: var(--sp-4);
		}

		.role-meta {
			flex-direction: row;
			align-items: center;
			gap: var(--sp-3);
		}
	}
</style>
