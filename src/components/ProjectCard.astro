---
import type { CollectionEntry } from 'astro:content';

interface Props {
	project: CollectionEntry<'projects'>;
	index: number;
}

const { project, index } = Astro.props;
const { title, blurb, tech, repo, live, status } = project.data;

const statusLabel = {
	live: 'Live',
	wip: 'In progress',
	archived: 'Archived',
}[status];

// The card must not look broken when a project has no links yet, which is
// the normal state for a seeded entry.
const primary = live ?? repo;
const hasLinks = Boolean(live || repo);
---

<article class="card hairline reveal" style={`--reveal-delay: ${index * 70}ms`}>
	<div class="card-top">
		<span class={`status status-${status}`}>{statusLabel}</span>
	</div>

	<h3 class="card-title">
		{
			primary ? (
				<a href={primary} target="_blank" rel="noopener noreferrer">
					{title}
					<span class="arrow" aria-hidden="true">↗</span>
					<span class="visually-hidden">(opens in a new tab)</span>
				</a>
			) : (
				title
			)
		}
	</h3>

	<p class="card-blurb">{blurb}</p>

	<ul class="tech">
		{tech.map((t) => <li>{t}</li>)}
	</ul>

	{
		hasLinks ? (
			<div class="card-links">
				{live && (
					<a href={live} target="_blank" rel="noopener noreferrer">
						Live site
						<span class="visually-hidden">(opens in a new tab)</span>
					</a>
				)}
				{repo && (
					<a href={repo} target="_blank" rel="noopener noreferrer">
						Source
						<span class="visually-hidden">(opens in a new tab)</span>
					</a>
				)}
			</div>
		) : (
			<p class="card-links card-nolink">Not yet public</p>
		)
	}
</article>

<style>
	.card {
		display: flex;
		flex-direction: column;
		gap: var(--sp-3);
		padding: var(--sp-6);
		background: var(--surface);
		transition:
			background var(--dur-base) var(--ease-out),
			transform var(--dur-base) var(--ease-out);
	}

	.card:hover {
		background: var(--surface-hover);
		transform: translateY(-2px);
	}

	.card-top {
		display: flex;
		justify-content: space-between;
	}

	.status {
		font-family: var(--font-mono);
		font-size: var(--step--1);
		letter-spacing: var(--tracking-label);
		text-transform: uppercase;
		color: var(--text-faint);
	}

	.status-live {
		color: var(--accent);
	}

	.card-title {
		font-size: var(--step-1);
		letter-spacing: -0.015em;
	}

	.card-title a {
		display: inline-flex;
		align-items: baseline;
		gap: var(--sp-3);
		transition: color var(--dur-fast) var(--ease-out);
	}

	.card-title a:hover {
		color: var(--accent);
	}

	.arrow {
		font-size: 0.7em;
		color: var(--text-faint);
		transition: transform var(--dur-fast) var(--ease-out);
	}

	.card-title a:hover .arrow {
		transform: translate(2px, -2px);
		color: var(--accent);
	}

	.card-blurb {
		color: var(--text-muted);
		font-size: var(--step-0);
		flex: 1;
	}

	.tech {
		display: flex;
		flex-wrap: wrap;
		gap: var(--sp-2);
		margin-top: var(--sp-2);
	}

	.tech li {
		font-family: var(--font-mono);
		font-size: var(--step--1);
		color: var(--text-muted);
		border: 1px solid var(--border);
		border-radius: var(--radius-sm);
		padding: 2px var(--sp-2);
	}

	.card-links {
		display: flex;
		gap: var(--sp-4);
		margin-top: var(--sp-3);
		padding-top: var(--sp-3);
		border-top: 1px solid var(--border);
		font-size: var(--step--1);
		font-weight: 550;
	}

	.card-links a {
		color: var(--accent);
		transition: opacity var(--dur-fast) var(--ease-out);
	}

	.card-links a:hover {
		opacity: 0.75;
	}

	.card-nolink {
		color: var(--text-faint);
		font-family: var(--font-mono);
		font-size: var(--step--1);
	}
</style>
