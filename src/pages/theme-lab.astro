---
/**
 * Throwaway comparison of three ways to get an ambient atmosphere.
 * Excluded from the sitemap in astro.config.mjs. Delete once a route is
 * chosen; nothing else imports from here.
 *
 * Each panel renders the same hero copy over a different technique and
 * reports its own frame rate, because the cost is half the decision.
 */
import '../styles/global.css';
import { profile } from '../data/profile';

const panels = [
	{
		id: 'video',
		label: 'A — Video background',
		note: 'Stand-in, not real footage: fractal noise rendered once to a canvas, upscaled and slowly drifting. Real footage would be sharper and more organic than this, not less.',
		cost: '~2-5 MB per visitor',
	},
	{
		id: 'shader',
		label: 'B — WebGL procedural smoke',
		note: 'Domain-warped fBm in a fragment shader, tinted with the existing --glow tokens. Drifts forever and never repeats.',
		cost: '~6 KB, no asset',
	},
	{
		id: 'svg',
		label: 'C — Animated SVG turbulence',
		note: 'feTurbulence with an animated baseFrequency, filtered at a 100x100 viewBox and stretched to fill. Cheap precisely because it is rendered small, which is also why it is soft and structureless next to B.',
		cost: '0 KB, filtered small then upscaled',
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Atmosphere lab</title>
		<meta name="robots" content="noindex" />
	</head>
	<body>
		{
			panels.map((p) => (
				<section class="panel" id={p.id}>
					<div class="bg" data-bg={p.id} />
					<div class="panel-inner">
						<p class="label">{p.label}</p>
						<h1>{profile.name}</h1>
						<p class="pitch">{profile.pitch}</p>
						<p class="note">{p.note}</p>
						<p class="cost">
							<span class="chip">{p.cost}</span>
							<span class="chip fps" data-fps={p.id}>
								measuring...
							</span>
						</p>
					</div>
				</section>
			))
		}

		<style>
			body {
				margin: 0;
			}

			.panel {
				position: relative;
				min-height: 100svh;
				display: grid;
				align-content: center;
				overflow: hidden;
				border-bottom: 1px solid var(--border);
			}

			.bg {
				position: absolute;
				inset: 0;
				z-index: 0;
			}

			.bg :global(canvas),
			.bg :global(svg) {
				position: absolute;
				inset: 0;
				width: 100%;
				height: 100%;
				display: block;
			}

			/* The footage stand-in: a low-res render blown up, which also
			   mimics the softness of a compressed video. */
			.bg[data-bg='video'] :global(canvas) {
				filter: blur(1px) saturate(1.1);
				animation: drift 38s ease-in-out infinite alternate;
				transform-origin: 55% 45%;
			}

			@keyframes drift {
				from {
					transform: scale(1.12) translate3d(-1.5%, -1%, 0);
				}
				to {
					transform: scale(1.26) translate3d(2%, 1.5%, 0);
				}
			}

			.panel-inner {
				position: relative;
				z-index: 2;
				width: min(68rem, 100%);
				margin-inline: auto;
				padding: var(--gutter);
				display: flex;
				flex-direction: column;
				align-items: flex-start;
				gap: var(--sp-4);
			}

			h1 {
				font-size: var(--step-4);
				font-weight: 600;
				margin: 0;
			}

			.pitch {
				font-size: var(--step-2);
				max-width: 22ch;
				line-height: 1.2;
				letter-spacing: -0.02em;
				margin: 0;
			}

			.note {
				color: var(--text-muted);
				max-width: 52ch;
				font-size: var(--step--1);
				margin: var(--sp-4) 0 0;
			}

			.cost {
				display: flex;
				gap: var(--sp-2);
				flex-wrap: wrap;
				margin: 0;
			}

			.chip {
				font-family: var(--font-mono);
				font-size: var(--step--1);
				border: 1px solid var(--border-strong);
				border-radius: 100px;
				padding: 2px var(--sp-3);
				background: var(--surface);
			}

			.fps {
				color: var(--accent);
			}
		</style>

		<script>
			const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

			/** Reads a colour token as 0..1 rgb, for feeding the shader. */
			function token(name: string): [number, number, number] {
				const v = getComputedStyle(document.documentElement)
					.getPropertyValue(name)
					.trim();
				const m = v.match(/[0-9.]+/g);
				if (!m || m.length < 3) return [0, 0, 0];
				return [+m[0] / 255, +m[1] / 255, +m[2] / 255];
			}

			/* ---------- A: footage stand-in ---------- */
			function buildVideoStandIn(host: HTMLElement) {
				const W = 480;
				const H = 270;
				const c = document.createElement('canvas');
				c.width = W;
				c.height = H;
				const ctx = c.getContext('2d');
				if (!ctx) return;

				const perm = new Uint8Array(512);
				for (let i = 0; i < 256; i++) perm[i] = i;
				for (let i = 255; i > 0; i--) {
					const j = (Math.random() * (i + 1)) | 0;
					const t = perm[i];
					perm[i] = perm[j];
					perm[j] = t;
				}
				for (let i = 0; i < 256; i++) perm[i + 256] = perm[i];

				const fade = (t: number) => t * t * t * (t * (t * 6 - 15) + 10);
				const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
				const grad = (h: number, x: number, y: number) =>
					(h & 1 ? x : -x) + (h & 2 ? y : -y);

				function noise(x: number, y: number) {
					const X = Math.floor(x) & 255;
					const Y = Math.floor(y) & 255;
					const fx = x - Math.floor(x);
					const fy = y - Math.floor(y);
					const u = fade(fx);
					const v = fade(fy);
					const A = perm[X] + Y;
					const B = perm[X + 1] + Y;
					return lerp(
						lerp(grad(perm[A], fx, fy), grad(perm[B], fx - 1, fy), u),
						lerp(
							grad(perm[A + 1], fx, fy - 1),
							grad(perm[B + 1], fx - 1, fy - 1),
							u
						),
						v
					);
				}

				function fbm(x: number, y: number) {
					let v = 0;
					let a = 0.5;
					let px = x;
					let py = y;
					for (let i = 0; i < 6; i++) {
						v += a * noise(px, py);
						px *= 2.03;
						py *= 2.01;
						a *= 0.5;
					}
					return v;
				}

				const g1 = token('--glow');
				const g2 = token('--glow-2');
				const bg = token('--bg');
				const img = ctx.createImageData(W, H);

				for (let y = 0; y < H; y++) {
					for (let x = 0; x < W; x++) {
						const nx = (x / W) * 3.2;
						const ny = (y / H) * 2;
						// Domain warp: what turns bland noise into something
						// that reads as smoke rather than static.
						const qx = fbm(nx, ny);
						const qy = fbm(nx + 3.1, ny + 1.7);
						let f = fbm(nx + 2.4 * qx, ny + 2.4 * qy);
						f = Math.max(0, Math.min(1, (f + 0.5) * 1.15));
						// Most of the field has to stay near-black or text cannot
						// sit on it. Raising f to a power crushes the mid-tones so
						// only the top of the range lights up, as wisps.
						const body = Math.pow(f, 2.4);
						const wisp = Math.pow(f, 6);
						const vx = x / W - 0.5;
						const vy = y / H - 0.5;
						const vig = Math.max(0, 1 - (vx * vx + vy * vy) * 2.1);
						const i = (y * W + x) * 4;
						for (let k = 0; k < 3; k++) {
							img.data[i + k] =
								255 *
								Math.min(
									1,
									bg[k] + (g1[k] * body * 0.5 + g2[k] * wisp * 0.85) * vig
								);
						}
						img.data[i + 3] = 255;
					}
				}
				ctx.putImageData(img, 0, 0);
				host.appendChild(c);
			}

			/* ---------- B: WebGL smoke ---------- */
			const FRAG = `
				precision highp float;
				uniform vec2 u_res; uniform float u_time;
				uniform vec3 u_c1; uniform vec3 u_c2; uniform vec3 u_bg;

				vec2 hash(vec2 p){
					p = vec2(dot(p, vec2(127.1, 311.7)), dot(p, vec2(269.5, 183.3)));
					return -1.0 + 2.0 * fract(sin(p) * 43758.5453123);
				}
				float noise(vec2 p){
					vec2 i = floor(p), f = fract(p);
					vec2 u = f * f * (3.0 - 2.0 * f);
					return mix(mix(dot(hash(i), f),
					               dot(hash(i + vec2(1.0, 0.0)), f - vec2(1.0, 0.0)), u.x),
					           mix(dot(hash(i + vec2(0.0, 1.0)), f - vec2(0.0, 1.0)),
					               dot(hash(i + vec2(1.0, 1.0)), f - vec2(1.0, 1.0)), u.x), u.y);
				}
				float fbm(vec2 p){
					float v = 0.0; float a = 0.5;
					for (int i = 0; i < 6; i++){ v += a * noise(p); p *= 2.02; a *= 0.5; }
					return v;
				}
				void main(){
					vec2 uv = gl_FragCoord.xy / u_res;
					vec2 p = uv * 2.0 - 1.0;
					p.x *= u_res.x / u_res.y;
					float t = u_time * 0.035;

					vec2 q = vec2(fbm(p * 1.2 + vec2(0.0, t)),
					              fbm(p * 1.2 + vec2(5.2, 1.3) - t * 0.8));
					vec2 r = vec2(fbm(p * 1.1 + 3.0 * q + vec2(1.7, 9.2) + t * 0.4),
					              fbm(p * 1.1 + 3.0 * q + vec2(8.3, 2.8) - t * 0.3));
					float f = fbm(p + 3.2 * r);
					f = smoothstep(-0.35, 0.75, f);

					// Crushed mid-tones: the field stays near-black and only the
					// brightest part of the noise becomes a visible wisp. This is
					// what lets body copy sit on top of it.
					float body = pow(f, 2.4);
					float wisp = pow(f, 6.0);

					vec3 col = u_bg;
					col = mix(col, u_c1, body * 0.50);
					col = mix(col, u_c2, wisp * 0.85);

					float vig = smoothstep(1.55, 0.10, length(p * vec2(0.62, 1.0)));
					col *= vig;
					gl_FragColor = vec4(col, 1.0);
				}
			`;

			function buildShader(host: HTMLElement, onFrame: () => void) {
				const c = document.createElement('canvas');
				host.appendChild(c);
				const gl = c.getContext('webgl');
				if (!gl) {
					host.textContent = 'WebGL unavailable';
					return null;
				}

				const vs = gl.createShader(gl.VERTEX_SHADER);
				const fs = gl.createShader(gl.FRAGMENT_SHADER);
				if (!vs || !fs) return null;
				gl.shaderSource(
					vs,
					'attribute vec2 a; void main(){ gl_Position = vec4(a, 0.0, 1.0); }'
				);
				gl.compileShader(vs);
				gl.shaderSource(fs, FRAG);
				gl.compileShader(fs);
				if (!gl.getShaderParameter(fs, gl.COMPILE_STATUS)) {
					console.error('fragment shader:', gl.getShaderInfoLog(fs));
					return null;
				}

				const prog = gl.createProgram();
				if (!prog) return null;
				gl.attachShader(prog, vs);
				gl.attachShader(prog, fs);
				gl.linkProgram(prog);
				gl.useProgram(prog);

				gl.bindBuffer(gl.ARRAY_BUFFER, gl.createBuffer());
				gl.bufferData(
					gl.ARRAY_BUFFER,
					new Float32Array([-1, -1, 3, -1, -1, 3]),
					gl.STATIC_DRAW
				);
				const loc = gl.getAttribLocation(prog, 'a');
				gl.enableVertexAttribArray(loc);
				gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);

				const uRes = gl.getUniformLocation(prog, 'u_res');
				const uTime = gl.getUniformLocation(prog, 'u_time');
				gl.uniform3fv(gl.getUniformLocation(prog, 'u_c1'), token('--glow'));
				gl.uniform3fv(gl.getUniformLocation(prog, 'u_c2'), token('--glow-2'));
				gl.uniform3fv(gl.getUniformLocation(prog, 'u_bg'), token('--bg'));

				const size = () => {
					const dpr = Math.min(devicePixelRatio, 1.5);
					c.width = Math.max(1, host.clientWidth * dpr);
					c.height = Math.max(1, host.clientHeight * dpr);
					gl.viewport(0, 0, c.width, c.height);
					gl.uniform2f(uRes, c.width, c.height);
				};
				size();
				addEventListener('resize', size);

				let running = false;
				const t0 = performance.now();
				const tick = () => {
					if (!running) return;
					gl.uniform1f(uTime, (performance.now() - t0) / 1000);
					gl.drawArrays(gl.TRIANGLES, 0, 3);
					onFrame();
					requestAnimationFrame(tick);
				};

				return {
					start() {
						if (!running) {
							running = true;
							requestAnimationFrame(tick);
						}
					},
					stop() {
						running = false;
					},
				};
			}

			/* ---------- C: SVG turbulence ---------- */
			function buildSvg(host: HTMLElement) {
				host.innerHTML = [
					'<svg xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none" viewBox="0 0 100 100">',
					'<filter id="lab-smoke" x="0" y="0" width="100%" height="100%">',
					'<feTurbulence type="fractalNoise" baseFrequency="0.012 0.02" numOctaves="4" seed="7" result="t">',
					'<animate attributeName="baseFrequency" dur="18s" repeatCount="indefinite"',
					' values="0.012 0.02; 0.022 0.011; 0.012 0.02" />',
					'</feTurbulence>',
					'<feColorMatrix in="t" type="matrix"',
					' values="0 0 0 0 0.30  0 0 0 0 0.34  0 0 0 0 0.86  0 0 0 0.75 0" />',
					'</filter>',
					'<rect width="100" height="100" filter="url(#lab-smoke)" />',
					'</svg>',
				].join('');
			}

			/* ---------- frame-rate meter ---------- */
			function meter(id: string) {
				const el = document.querySelector<HTMLElement>('[data-fps="' + id + '"]');
				let frames = 0;
				let last = performance.now();
				return () => {
					frames++;
					const now = performance.now();
					if (now - last >= 1000) {
						if (el) {
							el.textContent = Math.round((frames * 1000) / (now - last)) + ' fps';
						}
						frames = 0;
						last = now;
					}
				};
			}

			/* ---------- wire up ---------- */
			const videoHost = document.querySelector<HTMLElement>('[data-bg="video"]');
			const shaderHost = document.querySelector<HTMLElement>('[data-bg="shader"]');
			const svgHost = document.querySelector<HTMLElement>('[data-bg="svg"]');

			if (videoHost) buildVideoStandIn(videoHost);
			if (svgHost) buildSvg(svgHost);
			const shader =
				shaderHost && !reduced ? buildShader(shaderHost, meter('shader')) : null;

			// A and C are driven by CSS and SMIL, so their rate is sampled from
			// outside rather than counted inside a render loop.
			for (const id of ['video', 'svg']) {
				const panel = document.querySelector<HTMLElement>('#' + id);
				if (!panel) continue;
				const bump = meter(id);
				let onScreen = false;
				new IntersectionObserver(
					(entries) => entries.forEach((e) => (onScreen = e.isIntersecting)),
					{ threshold: 0.25 }
				).observe(panel);
				const loop = () => {
					if (onScreen) bump();
					requestAnimationFrame(loop);
				};
				requestAnimationFrame(loop);
			}

			// The shader only runs while its own panel is on screen.
			const shaderPanel = document.querySelector<HTMLElement>('#shader');
			if (shader && shaderPanel) {
				new IntersectionObserver(
					(entries) =>
						entries.forEach((e) =>
							e.isIntersecting ? shader.start() : shader.stop()
						),
					{ threshold: 0.2 }
				).observe(shaderPanel);
			}
		</script>
	</body>
</html>
