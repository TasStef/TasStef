---
/**
 * Small line icons for the Outside work block. Inline SVG rather than image
 * files: they inherit currentColor so they work in both schemes with no
 * second asset, and they cost no extra request.
 */
interface Props {
	name: 'espresso' | 'gloves' | 'chess';
}

const { name } = Astro.props;
---

<svg
	class="interest-icon"
	viewBox="0 0 24 24"
	width="22"
	height="22"
	fill="none"
	stroke="currentColor"
	stroke-width="1.5"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
	focusable="false"
>
	{
		name === 'espresso' && (
			<>
				<path pathLength="1" d="M3 9h12v5a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V9Z" />
				<path pathLength="1" d="M15 10h2.5a2.5 2.5 0 0 1 0 5H15" />
				<path pathLength="1" d="M2 21h15" />
				<path class="steam" pathLength="1" d="M7 2.5c-.8 1-.8 2 0 1" />
				<path class="steam steam-b" pathLength="1" d="M11 2.5c-.8 1-.8 2 0 1" />
			</>
		)
	}
	{
		name === 'gloves' && (
			<>
				<path pathLength="1" d="M7 8a5 5 0 0 1 5-5h2a5 5 0 0 1 5 5v3a5 5 0 0 1-5 5h-3a4 4 0 0 1-4-4V8Z" />
				<path pathLength="1" d="M7 10H5.5A2.5 2.5 0 0 0 3 12.5 2.5 2.5 0 0 0 5.5 15H7" />
				<path pathLength="1" d="M8 16v3a2 2 0 0 0 2 2h5a2 2 0 0 0 2-2v-3" />
			</>
		)
	}
	{
		name === 'chess' && (
			<>
				<circle pathLength="1" cx="12" cy="5" r="2.6" />
				<path pathLength="1" d="M8.9 9.3h6.2" />
				<path pathLength="1" d="M10.3 9.3c0 3.4-1.3 6.1-3.4 8.2h10.2c-2.1-2.1-3.4-4.8-3.4-8.2" />
				<path pathLength="1" d="M6.9 17.5h10.2l1.6 3.1H5.3Z" />
			</>
		)
	}
</svg>

<style>
	.interest-icon {
		flex: none;
		color: var(--accent);

		/* --- Steam tuning ---------------------------------------------
		 * Every animation declaration below reads these, so changing the
		 * speed is one edit here rather than three further down.
		 *
		 * --steam-dur is the main control: one full cycle of a wisp fading
		 * in, rising and fading out. Lower is faster.
		 *
		 * Apparent speed is travel divided by duration, so shortening
		 * --steam-rise makes it look slower at the same duration. To make
		 * the steam move faster, change the duration.
		 */
		--steam-dur: 2s;
		--steam-ease: ease-in-out;
		--steam-stagger: 1.5s; /* offset between the two wisps */
		--steam-begin: 0s; /* raised below to clear the draw-in */
		--steam-drop: 1.5px; /* starts this far below its resting point */
		--steam-rise: 2.5px; /* travels this far above it */
	}

	/* Draw-in.
	 *
	 * Gated on .has-reveal, which only the motion script adds, so with JS
	 * off or unavailable the icons are simply drawn and nothing is hidden.
	 * .is-visible lives on the card in About.astro, hence :global.
	 */
	:global(:root.has-reveal) .interest-icon > * {
		stroke-dasharray: 1;
		stroke-dashoffset: 1;
	}

	:global(:root.has-reveal) :global(.is-visible) .interest-icon > * {
		animation: icon-draw 620ms var(--ease-out) forwards;
	}

	/* Each stroke follows the last, so the icon assembles itself rather
	   than every line appearing at once. */
	:global(:root.has-reveal) :global(.is-visible) .interest-icon > :nth-child(2) {
		animation-delay: 90ms;
	}
	:global(:root.has-reveal) :global(.is-visible) .interest-icon > :nth-child(3) {
		animation-delay: 180ms;
	}
	:global(:root.has-reveal) :global(.is-visible) .interest-icon > :nth-child(4) {
		animation-delay: 260ms;
	}
	:global(:root.has-reveal) :global(.is-visible) .interest-icon > :nth-child(5) {
		animation-delay: 330ms;
	}

	/* Steam.
	 *
	 * The draw-in owns stroke-dashoffset and this owns transform/opacity,
	 * so both can run on the same element without fighting. Once the icon
	 * has drawn, the wisps keep rising.
	 */
	.interest-icon .steam {
		animation: steam var(--steam-dur) var(--steam-ease) var(--steam-begin)
			infinite;
	}

	/* Offset so the two wisps drift rather than pulsing in lockstep. */
	.interest-icon .steam-b {
		animation-delay: calc(var(--steam-begin) + var(--steam-stagger));
	}

	/* The last steam stroke finishes drawing at 330ms delay + 620ms, so the
	   loop starts just after rather than fading in over a half-drawn wisp. */
	:global(:root.has-reveal) :global(.is-visible) .interest-icon {
		--steam-begin: 950ms;
	}

	/* Declared as one shorthand because a second rule setting `animation`
	   would replace the first rather than add to it. steam-b needs the full
	   shorthand too: a lone animation-delay here would apply to both
	   animations and delay the draw as well. */
	:global(:root.has-reveal) :global(.is-visible) .interest-icon .steam {
		animation:
			icon-draw 620ms var(--ease-out) forwards,
			steam var(--steam-dur) var(--steam-ease) var(--steam-begin) infinite;
	}

	:global(:root.has-reveal) :global(.is-visible) .interest-icon .steam-b {
		animation:
			icon-draw 620ms var(--ease-out) forwards,
			steam var(--steam-dur) var(--steam-ease)
				calc(var(--steam-begin) + var(--steam-stagger)) infinite;
	}

	@keyframes steam {
		0% {
			opacity: 0;
			transform: translateY(var(--steam-drop));
		}
		30% {
			opacity: 1;
		}
		65% {
			opacity: 0.55;
		}
		100% {
			opacity: 0;
			transform: translateY(calc(-1 * var(--steam-rise)));
		}
	}

	@keyframes icon-draw {
		to {
			stroke-dashoffset: 0;
		}
	}

	/* Reduced motion: no dash offset at all, so the icons are just there. */
	@media (prefers-reduced-motion: reduce) {
		.interest-icon .steam,
		:global(:root.has-reveal) :global(.is-visible) .interest-icon .steam {
			animation: none;
			opacity: 1;
			transform: none;
		}

		:global(:root.has-reveal) .interest-icon > * {
			stroke-dasharray: none;
			stroke-dashoffset: 0;
			animation: none;
		}
	}
</style>
