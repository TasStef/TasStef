---
import { brandMark } from '../../lib/brandMark';

/**
 * Self-serve accounting integration.
 *
 * The message is the contrast, not a literal scale: onboarding used to be a
 * long chain of manual hops, and became the client connecting their own
 * books in a couple of steps. The "90%" lives in the row's metric line
 * rather than in here, so the drawing never implies a measurement it is
 * not making.
 *
 * The two flow dots loop at different speeds, so the ratio is shown by the
 * animation rather than asserted by a label.
 */
const xero = brandMark('xero');
const quickbooks = brandMark('quickbooks');

const beforeSteps = [118, 163, 208, 253, 298, 343];
---

<svg
	class="diagram"
	viewBox="0 0 460 210"
	role="img"
	aria-label="Client onboarding before and after the self-serve integration"
	fill="none"
	stroke-linecap="round"
	stroke-linejoin="round"
>
	<!-- ============ BEFORE: a long chain of manual hops ============ -->
	<text class="lane-label" x="0" y="38">BEFORE</text>

	<path class="track" d="M18 66 H434" />
	<path class="flow flow-slow" style="--len: 416px; --gap: 402px" d="M18 66 H434" />

	<circle class="node-dot start" cx="18" cy="66" r="5" />
	{beforeSteps.map((x) => <circle class="node-dot" cx={x} cy="66" r="4" />)}
	<circle class="node-dot" cx="434" cy="66" r="5" />

	<!-- ============ AFTER: the client connects their own books ============ -->
	<text class="lane-label accent" x="0" y="128">AFTER</text>

	<g class="source">
		<rect x="14" y="141" width="32" height="32" rx="9" />
		{
			xero ? (
				<g transform="translate(20 147) scale(0.83)">
					<path class="mark" d={xero.path} />
					<title>{xero.title}</title>
				</g>
			) : (
				<text class="fallback" x="30" y="161">XERO</text>
			)
		}
	</g>

	<g class="source">
		<rect x="54" y="141" width="32" height="32" rx="9" />
		{
			quickbooks ? (
				<g transform="translate(60 147) scale(0.83)">
					<path class="mark" d={quickbooks.path} />
					<title>{quickbooks.title}</title>
				</g>
			) : (
				<text class="fallback" x="70" y="161">QB</text>
			)
		}
	</g>

	{/*
	  One continuous track with the box drawn over it on a solid fill. A
	  record entering a node and emerging is ordinary diagram semantics,
	  and it keeps the dash one consistent length along the whole lane.
	*/}
	<path class="track" d="M92 157 H300" />
	<path class="flow flow-fast" style="--len: 208px; --gap: 194px" d="M92 157 H300" />

	<rect class="box" x="126" y="141" width="100" height="32" rx="9" />
	<text class="box-label" x="176" y="161">Self-serve</text>

	<circle class="live-halo" cx="306" cy="157" r="11" />
	<circle class="node-dot live" cx="306" cy="157" r="5.5" />
</svg>

<style>
	.diagram {
		/* --- Flow tuning --------------------------------------------
		 * One edit changes the pace of both lanes. The ratio between
		 * them is the point, so they are derived from one base.
		 */
		--flow-base: 1.6s; /* AFTER: 208 units, ~130 u/s */
		--flow-slow: 8s; /* BEFORE: 416 units, ~52 u/s */
		--flow-dash: 14px;

		width: 100%;
		height: auto;
		display: block;
		overflow: visible;
	}

	.track {
		stroke: var(--border-strong);
		stroke-width: 1;
	}

	.node-dot {
		fill: var(--bg);
		stroke: var(--border-strong);
		stroke-width: 1;
	}

	.start {
		fill: var(--text-faint);
	}

	.live {
		fill: var(--accent);
		stroke: var(--accent);
	}

	/* Marks the end state as arrived at, without needing a label. */
	.live-halo {
		fill: none;
		stroke: var(--accent);
		stroke-width: 1;
		opacity: 0.28;
	}

	.box {
		fill: var(--bg-raised);
		stroke: var(--accent);
		stroke-width: 1;
	}

	.source rect {
		fill: var(--surface);
		stroke: var(--border-strong);
		stroke-width: 1;
	}

	.mark {
		fill: var(--text-muted);
	}

	/* Sized in viewBox units, so these shrink with the drawing. At 375px
	 * the diagram renders at roughly 0.65 scale, so 11 here landed at
	 * about 7px on screen. 16 keeps it legible where it matters most. */
	.lane-label,
	.box-label,
	.fallback {
		font-family: var(--font-mono);
		fill: var(--text-faint);
		font-size: 16px;
		letter-spacing: 0.1em;
	}

	.lane-label.accent {
		fill: var(--accent);
	}

	.box-label {
		fill: var(--text);
		text-anchor: middle;
		letter-spacing: 0.04em;
	}

	.fallback {
		text-anchor: middle;
		font-size: 11px;
	}

	/* --len is each path's real length, declared per path WITH units.
	 * Unitless, calc(-1 * var(--len)) does not resolve to a valid length
	 * and the keyframe is dropped silently: the animation still runs and
	 * reports progress, it just moves nothing.
	 *
	 * Normalising with pathLength would make the dash a PERCENTAGE of the
	 * path, so a short lane would get a proportionally tiny dash and the
	 * two lanes would not look like the same thing moving.
	 */
	.flow {
		stroke: var(--accent);
		stroke-width: 2;
		/* Plain values, no calc: calc() inside a dasharray LIST is left
		   unresolved, the whole pattern is ignored and the line paints
		   solid. --gap is therefore precomputed per path as len - dash. */
		stroke-dasharray: var(--flow-dash) var(--gap);
		animation: flow var(--flow-base) linear infinite;
	}

	.flow-slow {
		animation-duration: var(--flow-slow);
	}

	.flow-fast {
		animation-duration: var(--flow-base);
	}

	@keyframes flow {
		to {
			stroke-dashoffset: calc(-1 * var(--len));
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.flow {
			animation: none;
			opacity: 0;
		}
	}
</style>
