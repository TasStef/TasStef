---
// TEMPORARY scaffolding for choosing a visual direction.
// Delete this file and src/styles/themes-lab.css once a theme is picked.
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Experience from '../components/Experience.astro';
import Projects from '../components/Projects.astro';
import Skills from '../components/Skills.astro';
import Contact from '../components/Contact.astro';
import '../styles/themes-lab.css';

const themes = [
	{ id: 'lime', name: 'Lime', note: 'Current. Acid lime on near-black.' },
	{ id: 'ion', name: 'Ion', note: 'Periwinkle. The safe technical accent.' },
	{ id: 'ember', name: 'Ember', note: 'Warm amber. Human, less corporate.' },
	{ id: 'graphite', name: 'Graphite', note: 'No hue. Contrast does the work.' },
	{ id: 'daylight', name: 'Daylight', note: 'Warm light. Not another dark dev site.' },
	{ id: 'paper', name: 'Paper', note: 'Cool light. Editorial, classic blue.' },
];
---

<Base title="Theme lab">
	<div class="lab-bar">
		<div class="lab-inner">
			<span class="label lab-heading">Theme lab</span>
			<div class="lab-buttons">
				{
					themes.map((t) => (
						<button class="lab-btn" data-set-theme={t.id} title={t.note}>
							{t.name}
						</button>
					))
				}
			</div>
			<span class="label lab-note" id="lab-note"></span>
		</div>
	</div>

	<Hero />
	<Projects />
	<Experience />
	<Skills />
	<Contact />
</Base>

<script is:inline>
	// Applied before first paint so there is no flash of the default theme.
	(function () {
		var saved = null;
		try {
			saved = localStorage.getItem('theme-lab');
		} catch (e) {}
		document.documentElement.dataset.theme = saved || 'lime';
	})();
</script>

<script>
	const notes: Record<string, string> = {
		lime: 'Current. Acid lime on near-black.',
		ion: 'Periwinkle. The safe technical accent.',
		ember: 'Warm amber. Human, less corporate.',
		graphite: 'No hue. Contrast does the work.',
		daylight: 'Warm light. Not another dark dev site.',
		paper: 'Cool light. Editorial, classic blue.',
	};

	const noteEl = document.getElementById('lab-note');
	const buttons = document.querySelectorAll<HTMLButtonElement>('[data-set-theme]');

	function apply(id: string) {
		document.documentElement.dataset.theme = id;
		try {
			localStorage.setItem('theme-lab', id);
		} catch (e) {}
		for (const b of buttons) {
			b.setAttribute(
				'aria-pressed',
				String(b.dataset.setTheme === id)
			);
		}
		if (noteEl) noteEl.textContent = notes[id] ?? '';
	}

	for (const b of buttons) {
		b.addEventListener('click', () => apply(b.dataset.setTheme!));
	}

	// Number keys 1-6 cycle themes, which makes A/B comparison much faster.
	const order = ['lime', 'ion', 'ember', 'graphite', 'daylight', 'paper'];
	window.addEventListener('keydown', (e) => {
		const n = parseInt(e.key, 10);
		if (n >= 1 && n <= order.length) apply(order[n - 1]);
	});

	apply(document.documentElement.dataset.theme || 'lime');
</script>

<style>
	.lab-bar {
		position: sticky;
		top: 0;
		z-index: 50;
		background: color-mix(in srgb, var(--bg) 86%, transparent);
		backdrop-filter: blur(14px);
		border-bottom: 1px solid var(--border);
	}

	.lab-inner {
		max-width: var(--container);
		margin-inline: auto;
		padding: var(--sp-3) var(--gutter);
		display: flex;
		align-items: center;
		gap: var(--sp-4);
		flex-wrap: wrap;
	}

	.lab-heading {
		color: var(--accent);
	}

	.lab-buttons {
		display: flex;
		gap: var(--sp-2);
		flex-wrap: wrap;
	}

	.lab-btn {
		font: inherit;
		font-size: var(--step--1);
		font-family: var(--font-mono);
		color: var(--text-muted);
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: 100px;
		padding: var(--sp-1) var(--sp-3);
		cursor: pointer;
		transition:
			color var(--dur-fast) var(--ease-out),
			border-color var(--dur-fast) var(--ease-out);
	}

	.lab-btn:hover {
		color: var(--text);
		border-color: var(--border-strong);
	}

	.lab-btn[aria-pressed='true'] {
		color: var(--accent-ink);
		background: var(--accent);
		border-color: var(--accent);
	}

	.lab-note {
		margin-left: auto;
	}

	@media (max-width: 45rem) {
		.lab-note {
			display: none;
		}
	}
</style>
